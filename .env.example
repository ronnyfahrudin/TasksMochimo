# ─── Database ────────────────────────────────────────────────────────────────
# OPTION A — local PostgreSQL (recommended for dev):
DATABASE_URL="postgresql://mochimo:password@localhost:5432/DB_name?schema=public"
DIRECT_URL="postgresql://mochimo:password@localhost:5432/DB_name?schema=public"

# OPTION B — Supabase Postgres (for deployment):
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─── Supabase (client SDK — only needed if you use Supabase) ─────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ─── Auth.js (NextAuth v5) ───────────────────────────────────────────────────
# Required. Generate with:  openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Optional — Twitter OAuth 2.0 (developer.x.com).
# Leave empty to use username+password sign-up only.
AUTH_TWITTER_ID=""
AUTH_TWITTER_SECRET=""

# ─── Mochimo Mesh API (on-chain wallet verification, Rosetta-spec) ───────────
# Default endpoint is the public Mochimo Mesh node. Override if you run your own.
MOCHIMO_MESH_URL="https://api.mochimo.org"
MOCHIMO_MESH_NETWORK="mainnet"

# ─── Registration deposit wallet ─────────────────────────────────────────────
# Sign-up asks the user to send a small random amount of MCM from their wallet
# to THIS address; that payment is the proof they hold the keys. It receives
# real MCM — it MUST be a wallet you control.
# Paste the base58 tag as shown on Mochiscan; the hex is derived from it.
MOCHIMO_DEPOSIT_TAG="226qEKxKSKCXMVtmBFVPKAz7H5aVjgH"
# Optional: set only if you need to pin the hex by hand.
MOCHIMO_DEPOSIT_HEX=""

# ─── Free public-testing mode ────────────────────────────────────────────────
# "on"  → sign-up costs the user NOTHING: the challenge payment is skipped and
#         the wallet claim is created already-verified. MOCHIMO_DEPOSIT_TAG is
#         not needed. Anyone can register ANY wallet address, so ownership is
#         proven by nothing — use only for a throwaway public beta database.
#         The sign-up page shows a yellow "not verified" banner while it is on.
# unset / anything else → normal paid-challenge proof of ownership (default).
FREE_SIGNUP_MODE=""

# ─── AI moderation (auto-approve/reject task proofs) ─────────────────────────
# Set EITHER one. Leave both empty to route every submission to manual admin
# review (safe default).
ANTHROPIC_API_KEY=""
XAI_API_KEY=""                # Grok via api.x.ai

# ─── Monthly leaderboard reset cron ──────────────────────────────────────────
# Required if you wire Vercel Cron / Supabase pg_cron / Netlify Scheduled
# Functions to /api/cron/reset-leaderboard. Generate the same way as AUTH_SECRET.
CRON_SECRET=""

# ─── Admin allow-list ────────────────────────────────────────────────────────
# Lowercase Twitter handles, comma-separated. Users signing in via X with one
# of these handles are auto-promoted to ADMIN. For username-only accounts,
# promote manually via Prisma Studio (User.role = "ADMIN").
ADMIN_TWITTER_HANDLES="mochimo_admin"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Mochimo Tasks"
